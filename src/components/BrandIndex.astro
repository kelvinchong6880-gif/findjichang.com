---
import { brands } from '../data/brands';
import AffiliateButton from './AffiliateButton.astro';
import { Image } from 'astro:assets';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/brands/*.{png,jpg}', { eager: true });
const getImage = (slug: string) => images[`/src/assets/brands/${slug}.png`]?.default || images[`/src/assets/brands/${slug}.jpg`]?.default;

const { type } = Astro.props as { type: 'review' | 'speed' };
const prefix = type === 'review' ? '/jichang' : '/speed-test';
const suffix = type === 'review' ? '测评' : '测速资料汇总';
---
<ol class="brand-grid">
  {brands.map((brand) => {
    const avatarImg = getImage(brand.slug);
    return <li class="brand-card"><div class="brand-card-top">{avatarImg ? <Image src={avatarImg} alt={`${brand.name} logo`} width={42} height={42} loading="lazy" class="brand-avatar-img" /> : <span class="brand-avatar">{brand.name.slice(0, 1)}</span>}{brand.rank <= 9 && <span class="badge">重点关注</span>}</div><h2>{brand.name}</h2><div class="status-badges"><span class="status-badge">套餐已核验</span><span class="status-badge">节点快照已记录</span><span class="status-badge pending">性能待测试</span></div><dl><div><dt>最低价格</dt><dd>{brand.minPrice || '待核验'}</dd></div><div><dt>资料状态</dt><dd class="status-verified">已核验</dd></div></dl><div style="margin: 18px 0;"><AffiliateButton brand={brand} placement="summary" sourcePage={`${prefix}/`} /></div><a class="text-link" href={`${prefix}/${brand.slug}/`}>查看{suffix} <span>→</span></a></li>
  })}
</ol>
