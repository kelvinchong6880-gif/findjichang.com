---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import { brands } from '../data/brands';
const featured = brands.slice(0, 3);
const needs = [
  ['预算优先', '从套餐价格、流量和倍率开始比较', '<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg>', '/recommend/feimao-yun/'],
  ['稳定优先', '重点查看晚高峰表现与线路情况', '<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>', '/recommend/weifeng-stability/'],
  ['流媒体与 AI', '核对 Netflix、Disney+ 与 AI 服务解锁资料', '<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/><polygon points="10 8 15 10 10 12 10 8"/></svg>', '/recommend/firefly-streaming-ai/'],
];
---
<BaseLayout title="找机场｜机场测评、测速资料与新手教程" description="找机场汇总机场测评、测速资料、套餐信息和使用教程，帮助你在注册前看清价格、表现与风险。">
  <main>
    <section class="hero"><div class="hero-glow"></div><div class="page-shell hero-grid"><div class="hero-copy"><p class="eyebrow"><span></span> 独立整理 · 持续更新</p><h1>找到真正<br /><em>适合你的机场</em></h1><p class="hero-lead">汇总机场测评、测速资料、套餐信息和使用教程，帮助你在注册前看清价格、表现与使用风险。</p><div class="hero-actions"><a class="button" href="/recommend/">查看机场推荐 <span>→</span></a><a class="button button-secondary" href="/jichang/">浏览机场测评</a></div><p class="hero-note"><i>✓</i> 资料已明确标注来源与采集日期</p></div><div class="decision-card"><div class="decision-head"><span>选择参考</span><span class="live-dot">持续更新</span></div><div class="decision-score"><div><strong>37</strong><span>品牌档案</span></div><i></i><div><strong>74</strong><span>测评与测速页</span></div></div><ul><li><span>01</span><div><b>先看需求</b><small>预算、稳定性、使用场景</small></div></li><li><span>02</span><div><b>再看证据</b><small>来源、时间与测试条件</small></div></li><li><span>03</span><div><b>最后注册</b><small>核实价格、条款与风险</small></div></li></ul></div></div></section>
    <section class="trust-strip"><div class="page-shell"><div><b>资料透明</b><span>标注来源与采集时间</span></div><div><b>拒绝猜测</b><span>未核验信息明确说明</span></div><div><b>新手友好</b><span>用简单语言解释复杂概念</span></div><div><b>客观中立</b><span>不为服务商提供保证</span></div></div></section>
    <section class="page-shell home-section"><div class="section-heading"><div><p class="eyebrow">优先整理</p><h2>重点品牌测评</h2></div><a class="text-link" href="/jichang/">查看全部 37 家 <span>→</span></a></div><div class="featured-grid">{featured.map((brand, index) => <article class="featured-card"><div class="brand-card-top">{brand.avatar ? <img src={brand.avatar} width="48" height="48" alt={`${brand.name}品牌头像`} class="brand-avatar-img large" /> : <span class="brand-avatar large">{brand.name.slice(0,1)}</span>}<span class:list={['badge', index === 0 && 'badge-primary']}>{index === 0 ? '优先推荐' : '重点关注'}</span></div><h3>{brand.name}</h3><p>套餐、节点与来源资料已按证据边界整理。</p><div class="status-row"><span><i style="background:var(--green)"></i>资料已整理</span><span>持续复核</span></div><div style="margin: 18px 0;"><AffiliateButton brand={brand} placement="summary" sourcePage="/" /></div><div class="card-actions"><a class="button button-secondary" href={`/jichang/${brand.slug}/`}>查看测评</a><a class="text-link" href={`/speed-test/${brand.slug}/`}>测速资料 →</a></div></article>)}</div></section>
    <section class="needs-section"><div class="page-shell"><div class="section-heading"><div><p class="eyebrow">按需求选择</p><h2>不必从 37 家里盲选</h2></div><p>先确定最重要的需求，再缩小选择范围。</p></div><div class="needs-grid">{needs.map(([title, desc, icon, href]) => <a href={href} class="need-card"><span class="icon-wrap" set:html={icon} /><div class="need-content"><h3>{title}</h3><p>{desc}</p></div><div class="need-action"><span>查看推荐指南</span><i>→</i></div></a>)}</div></div></section>
    <section class="page-shell methodology"><div><p class="eyebrow">我们的资料原则</p><h2>每个结论，都应该能找到依据</h2><p>本站区分服务商公开资料、后台节点快照、第三方样本和独立测试。只有保留测试日期、设备、网络、时段与原始记录的结果，才会标注为本站实测。</p><a class="text-link" href="/methodology/">查看完整方法说明 <span>→</span></a></div><ol><li><span>1</span><div><b>核验</b><p>记录资料来源、采集日期和适用边界</p></div></li><li><span>2</span><div><b>测试</b><p>具备完整环境与原始记录时才标注实测</p></div></li><li><span>3</span><div><b>更正</b><p>发现变化或错误后更新正文并保留说明</p></div></li></ol></section>
  </main>
</BaseLayout>
