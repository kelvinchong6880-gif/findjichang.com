---
import BaseLayout from '../layouts/BaseLayout.astro';
import { brands } from '../data/brands';
const featured = brands.slice(0, 3);
const needs = [
  ['预算优先', '从套餐价格、流量和倍率开始比较', '¥', '/recommend/feimao-yun/'],
  ['稳定优先', '重点查看晚高峰表现与线路情况', '↗', '/recommend/'],
  ['流媒体与 AI', '核对 Netflix、Disney+ 与 AI 服务解锁资料', '◎', '/recommend/'],
];
---
<BaseLayout title="找机场｜机场测评、测速资料与新手教程" description="找机场汇总机场测评、测速资料、套餐信息和使用教程，帮助你在注册前看清价格、表现与风险。">
  <main>
    <section class="hero"><div class="hero-glow"></div><div class="page-shell hero-grid"><div class="hero-copy"><p class="eyebrow"><span></span> 独立整理 · 持续更新</p><h1>找到真正<br /><em>适合你的机场</em></h1><p class="hero-lead">汇总机场测评、测速资料、套餐信息和使用教程，帮助你在注册前看清价格、表现与使用风险。</p><div class="hero-actions"><a class="button" href="/recommend/">查看机场推荐 <span>→</span></a><a class="button button-secondary" href="/jichang/">浏览机场测评</a></div><p class="hero-note"><i>✓</i> 第三方资料明确标注来源与采集日期</p></div><div class="decision-card"><div class="decision-head"><span>选择参考</span><span class="live-dot">持续更新</span></div><div class="decision-score"><div><strong>36</strong><span>品牌档案</span></div><i></i><div><strong>72</strong><span>测评与测速页</span></div></div><ul><li><span>01</span><div><b>先看需求</b><small>预算、稳定性、使用场景</small></div></li><li><span>02</span><div><b>再看证据</b><small>来源、时间与测试条件</small></div></li><li><span>03</span><div><b>最后注册</b><small>核实价格、条款与风险</small></div></li></ul></div></div></section>
    <section class="trust-strip"><div class="page-shell"><div><b>资料透明</b><span>标注来源与采集时间</span></div><div><b>拒绝猜测</b><span>未核验信息明确说明</span></div><div><b>新手友好</b><span>用简单语言解释复杂概念</span></div><div><b>推广披露</b><span>推广关系清楚展示</span></div></div></section>
    <section class="page-shell home-section"><div class="section-heading"><div><p class="eyebrow">优先整理</p><h2>重点品牌测评</h2></div><a class="text-link" href="/jichang/">查看全部 36 家 <span>→</span></a></div><div class="featured-grid">{featured.map((brand, index) => <article class="featured-card"><div class="brand-card-top"><span class="brand-avatar large">{brand.name.slice(0,1)}</span><span class:list={['badge', index === 0 && 'badge-primary']}>{index === 0 ? '优先推荐' : '重点关注'}</span></div><h3>{brand.name}</h3><p>独立品牌档案已经建立，价格、套餐和体验资料将在核验后补充。</p><div class="status-row"><span><i></i>资料核验中</span><span>更新日期：待补充</span></div><div class="card-actions"><a class="button button-secondary" href={`/jichang/${brand.slug}/`}>查看测评</a><a class="text-link" href={`/speed-test/${brand.slug}/`}>测速资料 →</a></div></article>)}</div></section>
    <section class="needs-section"><div class="page-shell"><div class="section-heading"><div><p class="eyebrow">按需求选择</p><h2>不必从 36 家里盲选</h2></div><p>先确定最重要的需求，再缩小选择范围。</p></div><div class="needs-grid">{needs.map(([title, desc, icon, href]) => <a href={href} class="need-card"><span>{icon}</span><div><h3>{title}</h3><p>{desc}</p></div><b>→</b></a>)}</div></div></section>
    <section class="page-shell methodology"><div><p class="eyebrow">我们的资料原则</p><h2>每个结论，都应该能找到依据</h2><p>第三方测试结果不会包装成找机场自行实测。测速页面将记录来源、采集日期、测试设备、网络、时段及数据限制。</p><a class="text-link" href="/methodology/">查看完整方法说明 <span>→</span></a></div><ol><li><span>1</span><div><b>收集</b><p>查找可核验的官网与第三方资料</p></div></li><li><span>2</span><div><b>核对</b><p>记录来源、时间和测试条件</p></div></li><li><span>3</span><div><b>整理</b><p>区分事实、引用和编辑判断</p></div></li></ol></section>
  </main>
</BaseLayout>
