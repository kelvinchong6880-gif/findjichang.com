---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import JsonLd from '../../components/JsonLd.astro';
import { isPublishable } from '../../lib/seo';
import { articleSchema } from '../../lib/structured-data';
import { keywordSet } from '../../lib/seo-keywords';
export async function getStaticPaths(){return (await getCollection('comparisons')).map(entry=>({params:{slug:entry.id},props:{entry}}));}
const { entry } = Astro.props;
const { Content } = await render(entry);
const comparisonLinks = [
  ...entry.data.brandSlugs.map((slug) => ({ href: `/jichang/${slug}/`, title: `${slug === 'weifeng' ? '微风' : slug === 'sogo-yun' ? 'SOGO云' : slug === 'feimao-yun' ? '飞猫云' : slug}机场品牌资料` })),
  { href: '/compare/', title: '返回 36 家机场对比表' },
  { href: '/methodology/', title: '本站评测与证据方法' },
  { href: '/knowledge/how-to-read-speed-test/', title: '怎样看懂机场测速结果' },
];
const path = `/compare/${entry.id}/`;
const keywords = keywordSet({ title: entry.data.title, supplied: entry.data.keywords, type: 'comparison' });
const schema = articleSchema({ title: entry.data.title, description: entry.data.description, path, publishedAt: entry.data.publishedAt ?? entry.data.createdAt, updatedAt: entry.data.updatedAt });
---
<BaseLayout title={`${entry.data.title}｜找机场`} description={entry.data.description} indexable={isPublishable(entry)} ogType="article" keywords={keywords}>
  <JsonLd data={schema} />
  <main class="page-shell detail-page">
    <Breadcrumbs items={[{label:'首页',href:'/'},{label:'机场对比',href:'/compare/'},{label:entry.data.title}]}/>
    <section class="review-hero" style="grid-template-columns:1fr"><div><span class="badge">资料对比</span><h1>{entry.data.title}</h1><p>{entry.data.description}</p></div></section>
    <section class="content-layout" style="grid-template-columns:1fr"><article class="article-content"><Content/><RelatedLinks links={comparisonLinks} title="继续比较与核验" /></article></section>
  </main>
</BaseLayout>
