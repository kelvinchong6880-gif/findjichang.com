---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionPage from '../../components/SectionPage.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
guides.sort((a, b) => a.data.createdAt.getTime() - b.data.createdAt.getTime());
---
<BaseLayout title="使用教程｜找机场" description="客户端安装、订阅导入和常见问题教程。">
  <SectionPage title="使用教程" description="为 Windows、macOS、Android 与 iOS 新手整理安装、配置和排错教程。">
    <ul class="brand-grid" style="margin-top: 40px;">
      {guides.map(guide => (
        <li class="brand-card">
          <h2 style="font-size: 18px; margin-top: 0;">{guide.data.title}</h2>
          <p style="font-size: 13px; line-height: 1.6; min-height: 80px;">{guide.data.description}</p>
          <div class="card-actions">
            <a class="button button-secondary" href={`/guide/${guide.id}/`}>阅读完整教程</a>
          </div>
        </li>
      ))}
    </ul>
  </SectionPage>
</BaseLayout>
