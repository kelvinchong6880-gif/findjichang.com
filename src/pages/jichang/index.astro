---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionPage from '../../components/SectionPage.astro';
import BrandIndex from '../../components/BrandIndex.astro';
import { brands } from '../../data/brands';
---
<BaseLayout title={`机场测评大全2026：${brands.length}家机场套餐价格与节点测评｜找机场`} description={`机场测评大全（2026年10月更新）：本站收录的 ${brands.length} 家机场都有独立测评页，整理每家的官网套餐价格、月付和年付入门价、后台节点记录、适合人群和购买注意事项，可以按名称、预算和付款周期筛选，找到适合自己的机场。`}>
  <SectionPage title="机场测评" description={`${brands.length} 家品牌各有独立测评页，并与对应测速资料汇总互相连接。`}>
    <BrandIndex type="review" />
  </SectionPage>
</BaseLayout>
