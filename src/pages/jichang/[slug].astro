---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import { brands, type Brand } from '../../data/brands';
export function getStaticPaths() { return brands.map((brand) => ({ params: { slug: brand.slug }, props: { brand } })); }
const { brand } = Astro.props as { brand: Brand };
const entry = (await getCollection('reviews')).find((item) => item.id === brand.slug);
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const pagePath = `/jichang/${brand.slug}/`;
const isWeifeng = brand.slug === 'weifeng';
const isSogo = brand.slug === 'sogo-yun';
const isFeimao = brand.slug === 'feimao-yun';
const isMuguang = brand.slug === 'muguang';
const isWuyou = brand.slug === 'wuyou';
const isKuajie = brand.slug === 'kuajie-yun';
const isShanyue = brand.slug === 'shanyue';
const articleVerdict = isWeifeng ? '套餐已核验，体验仍待核验' : isSogo ? '九种套餐已核验，体验仍待核验' : isFeimao ? '七种套餐已核验，长期表现待核验' : isMuguang ? '九种套餐已核验，部分流量待确认' : isWuyou ? '七种套餐已核验，体验仍待核验' : isKuajie ? '五种套餐已核验，晚高峰待核验' : isShanyue ? '五种套餐已核验，原始测速待补' : '资料已汇总，关键项目待核验';
const articleVerdictNote = isWeifeng ? '套餐来自登录后官方面板截图；线路质量、晚高峰与解锁能力仍缺少完整证据。' : isSogo ? '九种套餐来自登录后官方面板截图；卡片与详情的个别数字不一致，付款前仍需确认。' : isFeimao ? '七种套餐来自登录后官方面板截图；7月晚高峰样本与8月监测趋势需要结合判断。' : isMuguang ? '九种套餐来自登录后官方面板截图；标准版与年付轻量版存在流量口径矛盾。' : isWuyou ? '七种套餐来自登录后官方面板截图；速度与解锁仍是服务商提供的单次样本。' : isKuajie ? '五种套餐来自登录后官方面板截图；现有50节点测速只是下午服务商样本。' : isShanyue ? '五种套餐来自登录后官方面板截图；竞争页面性能数字缺少测试环境和原始数据。' : '官方公开信息与第三方样本已分开标注；当前套餐和晚高峰仍需验证。';
const tocItems = isWeifeng ? [
  ['#微风机场是什么','品牌概况'],['#套餐与价格登录后官方面板截图已核验','套餐与价格'],['#线路和节点覆盖','线路与节点'],['#速度与稳定性','速度与稳定性'],['#注册前检查清单','注册前检查'],
] : isSogo ? [
  ['#sogo云是什么','品牌概况'],['#登录后官方面板的九种套餐','套餐与价格'],['#客户端和使用方式','客户端'],['#线路节点与解锁能力','线路与节点'],['#适合谁与主要风险','适用与风险'],
] : isFeimao ? [
  ['#飞猫云是什么','品牌概况'],['#登录后官方面板的七种套餐','套餐与价格'],['#线路与节点','线路与节点'],['#晚高峰表现与持续监测','测速与趋势'],['#注册前检查清单','注册前检查'],
] : isMuguang ? [
  ['#暮光机场是什么','品牌概况'],['#登录后官方面板的九种套餐','套餐与价格'],['#线路节点与使用方式','线路与节点'],['#晚间测速能说明什么','测速限制'],['#注册前检查清单','注册前检查'],
] : isWuyou ? [
  ['#无忧链接是什么','品牌概况'],['#套餐与价格','套餐与价格'],['#线路协议和节点','线路与节点'],['#晚间速度与解锁样本','测速与解锁'],['#注册前检查清单','注册前检查'],
] : isKuajie ? [
  ['#跨界云是什么','品牌概况'],['#登录后官方面板的五种套餐','套餐与价格'],['#线路协议与客户端','线路与客户端'],['#速度与解锁样本','测速与解锁'],['#注册前检查清单','注册前检查'],
] : isShanyue ? [
  ['#闪跃是什么','品牌概况'],['#登录后官方面板的五种套餐','套餐与价格'],['#线路节点与解锁权益','线路与解锁'],['#测速资料为什么不能直接采用','测速证据'],['#注册前检查清单','注册前检查'],
] : [
  ['#品牌资料','品牌概况'],['#套餐与价格','套餐与价格'],['#线路与节点','线路与节点'],['#速度与稳定性','测速资料'],['#注册前检查清单','注册前检查'],
];
---
<BaseLayout title={entry?.data.title ?? `${brand.name}机场测评｜找机场`} description={entry?.data.description ?? `${brand.name}机场的独立测评页面。`} indexable={false}>
<main class="page-shell detail-page"><Breadcrumbs items={[{label:'首页',href:'/'},{label:'机场测评',href:'/jichang/'},{label:`${brand.name}机场测评`}]} />
<section class="review-hero"><div><div class="detail-meta"><span class="badge">品牌测评</span><span>优先级 {brand.rank}</span><span>资料状态：{Content ? '事实核验中' : '核验中'}</span></div><h1>{entry?.data.title ?? `${brand.name}机场测评`}</h1><p>{entry?.data.description ?? '价格、套餐、线路和使用表现将在内容阶段依据可核验资料逐项填写。'}</p><div class="hero-actions"><AffiliateButton brand={brand} placement="hero" sourcePage={pagePath} /><a class="button button-secondary" href={`/speed-test/${brand.slug}/`}>查看测速资料</a></div><small>推广披露：通过注册链接注册，本站可能获得佣金。点击只代表注册意向，不代表已经注册。</small></div><aside class="verdict-card"><span>编辑结论</span><strong>{Content ? articleVerdict : '等待资料核验'}</strong><p>{Content ? articleVerdictNote : '关键价格与服务信息核验前，不给出推荐结论。'}</p></aside></section>
{Content ? <section class="content-layout"><article class="article-content"><Content /></article><aside class="toc-card"><b>本页目录</b>{tocItems.map(([href,label]) => <a href={href}>{label}</a>)}</aside></section> : <section class="content-layout"><article><div class="content-placeholder"><h2>测评内容结构</h2><div class="skeleton-lines"><i></i><i></i><i></i></div><p>后续补充套餐价格、优点不足、节点线路、流媒体及 AI 服务、适用人群和常见问题。</p></div></article><aside class="toc-card"><b>本页目录</b><a href="#">结论摘要</a><a href="#">套餐与价格</a><a href="#">线路与节点</a></aside></section>}
</main></BaseLayout>
