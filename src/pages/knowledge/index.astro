---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionPage from '../../components/SectionPage.astro';
import { getCollection } from 'astro:content';
const entries = await getCollection('knowledge');
entries.sort((a,b) => a.data.createdAt.getTime() - b.data.createdAt.getTime());
const clusters = [
  ['线路与网络基础',['line-types-explained','bgp-transit-explained','dedicated-line-stability','ip-types-explained','entry-exit-node-explained']],
  ['测速与性能判断',['how-to-read-speed-test','fast-test-slow-browsing','peak-hour-testing','latency-reference-ranges','speed-test-tools-compared']],
  ['套餐、流量与价格',['traffic-multiplier-and-renewal','monthly-data-estimator','monthly-vs-annual-plan','unlimited-devices-explained','speed-connection-thread-limits']],
  ['节点、订阅与客户端',['subscription-link-security','nodes-subscriptions-rules','proxy-protocols-compared','hysteria2-tuic-reality','client-speed-differences']],
  ['流媒体、AI 与 IP 风险',['netflix-unlock-meaning','google-works-ai-fails','chatgpt-error-codes','tiktok-region-errors','ai-streaming-line-claims']],
  ['安全、隐私与购买风险',['proxy-privacy-https','free-node-risks','shutdown-risk-checklist','subscription-leak-response','legal-account-payment-risks']],
] as const;
const byId = new Map(entries.map(entry=>[entry.id,entry]));
---
<BaseLayout title="新手必看的防坑机场知识科普：看懂专线原理、测速与购买风险｜找机场" description="找机场为您科普最核心的机场基础知识，帮助小白用户深入理解网络线路类型、测速结果解读、流量倍率计算规则以及长周期套餐的购买风险。我们通过通俗易懂的原理讲解，带您看穿各家服务商的营销套路与宣传术语，让您在挑选代理服务和日常排错时不再迷茫，成为真正懂行的精明消费者。">
  <SectionPage title="机场知识" description="用不依赖特定服务商的基础知识，帮助你读懂套餐、测速结果和常见宣传术语。">
    {clusters.map(([label,ids]) => <section class="knowledge-cluster"><h2>{label}</h2><ul class="brand-grid">{ids.map(id=>byId.get(id)).filter(Boolean).map(entry => <li class="brand-card"><span class="badge">知识基础</span><h2>{entry!.data.title}</h2><p>{entry!.data.description}</p><a class="text-link" href={`/knowledge/${entry!.id}/`}>阅读文章 <span>→</span></a></li>)}</ul></section>)}
  </SectionPage>
</BaseLayout>
