---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionPage from '../../components/SectionPage.astro';
import { getCollection } from 'astro:content';
const entries = await getCollection('knowledge');
entries.sort((a,b) => a.data.createdAt.getTime() - b.data.createdAt.getTime());
---
<BaseLayout title="机场知识｜找机场" description="理解线路、测速、流量倍率与购买风险。">
  <SectionPage title="机场知识" description="用不依赖特定服务商的基础知识，帮助你读懂套餐、测速结果和常见宣传术语。">
    <ul class="brand-grid">
      {entries.map(entry => <li class="brand-card"><span class="badge">知识基础</span><h2>{entry.data.title}</h2><p>{entry.data.description}</p><a class="text-link" href={`/knowledge/${entry.id}/`}>阅读文章 <span>→</span></a></li>)}
    </ul>
  </SectionPage>
</BaseLayout>
