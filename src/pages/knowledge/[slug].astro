---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { isPublishable } from '../../lib/seo';
import { articleSchema } from '../../lib/structured-data';
import { relatedContent, toCandidate } from '../../lib/related-content';
import { keywordSet } from '../../lib/seo-keywords';
export async function getStaticPaths(){return (await getCollection('knowledge')).map(entry=>({params:{slug:entry.id},props:{entry}}));}
const { entry } = Astro.props; const { Content } = await render(entry);
const allKnowledge = (await getCollection('knowledge')).map((item) => toCandidate(item, 'knowledge'));
const allGuides = (await getCollection('guides')).map((item) => toCandidate(item, 'guide'));
const related = relatedContent(toCandidate(entry, 'knowledge'), [...allKnowledge, ...allGuides], 5);
const path = `/knowledge/${entry.id}/`;
const createdText = entry.data.createdAt.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' });
const updatedText = (entry.data.updatedAt ?? entry.data.createdAt).toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' });
const schema = articleSchema({ title: entry.data.title, description: entry.data.description, path, publishedAt: entry.data.publishedAt ?? entry.data.createdAt, updatedAt: entry.data.updatedAt });
const keywords = keywordSet({ title: entry.data.title, supplied: entry.data.keywords, type: 'knowledge' });
---
<BaseLayout title={`${entry.data.title}｜找机场`} description={entry.data.description} indexable={isPublishable(entry)} ogType="article" keywords={keywords}>
  <JsonLd data={schema} />
  <main class="page-shell detail-page">
    <Breadcrumbs items={[{label:'首页',href:'/'},{label:'机场知识',href:'/knowledge/'},{label:entry.data.title}]}/>
    <section class="review-hero" style="grid-template-columns:1fr"><div><span class="badge">机场知识</span><h1>{entry.data.title}</h1><p>{entry.data.description}</p><p class="article-meta">首次整理：{createdText} · 最近更新：{updatedText} · 当前状态：编辑中</p></div></section>
    <section class="content-layout" style="grid-template-columns:1fr"><article class="article-content"><Content/><RelatedLinks links={related} title="相关知识与教程" /></article></section>
  </main>
</BaseLayout>
