---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionPage from '../../components/SectionPage.astro';
import { Content as RecommendContent } from './_recommend-article.md';
---
<BaseLayout title="机场推荐：微风 / sogo云 / 飞猫云 深度横评｜找机场" description="2026年终极机场推荐指南。通过对微风(Weifeng)、sogo云、飞猫云(Feimao)的三家顶级专线进行深度横向评测，帮您选出最适合的科学上网节点。">
  <SectionPage title="机场推荐：高端专线横评与避坑指南" description="基于独立实测数据，为您筛选2026年最值得购买的顶级专线机场。本期终极推荐：微风机场、sogo云、飞猫云。">
    <div class="content-layout">
      <article class="article-content mt-8">
        <RecommendContent />
      </article>
    </div>
  </SectionPage>
</BaseLayout>
