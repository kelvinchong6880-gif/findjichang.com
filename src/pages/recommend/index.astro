<BaseLayout title="机场候选与购买前检查｜找机场" description="整理微风、SOGO云与飞猫云的公开资料和购买前核对项目，不把未经验证的信息写成本站实测。">
  <SectionPage title="机场候选与购买前检查" description="按预算、设备、流量规则与短期测试方法比较候选服务；当前不提供未经验证的速度排名。">
    <div class="content-layout">
      <article class="article-content mt-8">
        <RecommendContent />
      </article>
    </div>
  </SectionPage>
</BaseLayout>
