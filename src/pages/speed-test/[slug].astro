---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { brands, type Brand } from '../../data/brands';
export function getStaticPaths() { return brands.map((brand) => ({ params: { slug: brand.slug }, props: { brand } })); }
const { brand } = Astro.props as { brand: Brand };
const entry = (await getCollection('speedTests')).find((item) => item.id === brand.slug);
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---
<BaseLayout title={entry?.data.title ?? `${brand.name}机场测速资料汇总｜找机场`} description={entry?.data.description ?? `${brand.name}机场测速资料、测试条件与来源汇总。`} indexable={false}><main class="page-shell detail-page"><Breadcrumbs items={[{label:'首页',href:'/'},{label:'机场测速',href:'/speed-test/'},{label:`${brand.name}机场测速资料汇总`}]} /><section class="speed-hero"><p class="eyebrow">找机场测速资料汇总</p><h1>{entry?.data.title ?? `${brand.name}机场测速资料汇总`}</h1><p>{entry?.data.description ?? '只汇总注明来源、测试条件和采集日期的资料，不会把第三方结果表述为找机场自行实测。'}</p><a class="text-link" href={`/jichang/${brand.slug}/`}>返回 {brand.name}机场测评 <span>→</span></a></section><section class="metric-grid">{[['延迟','待核验','ms'],['下载速度','待核验','Mbps'],['上传速度','待核验','Mbps'],['丢包率','待核验','%']].map(([label,value,unit]) => <div><span>{label}</span><strong>{value}</strong><small>{unit}</small></div>)}</section>{Content ? <article class="article-content speed-article"><Content /></article> : <section class="source-panel"><div><span class="badge">资料要求</span><h2>数据来源与测试条件</h2><p>正式发布时，每组数据必须记录设备、网络、客户端、时段、原始截图和来源网址。</p></div></section>}</main></BaseLayout>
