---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../config/site';
import JsonLd from '../components/JsonLd.astro';
import { organizationSchema, websiteSchema } from '../lib/structured-data';

interface Props {
  title: string;
  description: string;
  socialImage?: string | null;
  indexable?: boolean;
  ogType?: 'website' | 'article';
  keywords?: string[];
}

const isDetailPage = /^\/(jichang|speed-test)\/[^/]+\/$/.test(Astro.url.pathname);
const { title, description, socialImage, indexable = !isDetailPage, ogType = 'website', keywords = [] } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, site.url);
const resolvedSocialImage = socialImage === undefined ? (isDetailPage ? null : '/og.png') : socialImage;
const socialImageUrl = resolvedSocialImage ? new URL(resolvedSocialImage, site.url) : null;
const robots = site.allowIndexing && indexable ? 'index, follow' : 'noindex, follow';
const cloudflareAnalyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN;
const bingSiteAuth = import.meta.env.PUBLIC_BING_SITE_AUTH;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="robots" content={robots} />
    <meta name="bingbot" content={robots} />
    {bingSiteAuth && <meta name="msvalidate.01" content={bingSiteAuth} />}
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {Astro.url.pathname === '/' && <JsonLd data={[websiteSchema(), organizationSchema()]} />}
    {cloudflareAnalyticsToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cloudflareAnalyticsToken })}></script>}
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <SiteHeader />
      <slot />
      <SiteFooter />
    </div>
    <script is:inline>
      (() => {
        const makeId = (text, index, used) => {
          const base = text.trim().toLowerCase()
            .replace(/[^\p{Letter}\p{Number}]+/gu, '-')
            .replace(/^-|-$/g, '') || `section-${index + 1}`;
          let id = base;
          let suffix = 2;
          while (used.has(id) || document.getElementById(id)) id = `${base}-${suffix++}`;
          used.add(id);
          return id;
        };

        document.querySelectorAll('.article-content').forEach((article) => {
          const headings = [...article.querySelectorAll('h2, h3')];
          if (!headings.length) return;

          let layout = article.parentElement;
          if (!layout?.classList.contains('content-layout')) {
            layout = document.createElement('section');
            layout.className = 'content-layout generated-content-layout';
            article.before(layout);
            layout.append(article);
          }
          layout.classList.add('has-article-toc');

          let toc = layout.querySelector(':scope > .toc-card');
          if (!toc) {
            toc = document.createElement('aside');
            toc.className = 'toc-card article-toc';
            layout.append(toc);
          } else {
            toc.classList.add('article-toc');
            toc.replaceChildren();
          }
          toc.setAttribute('aria-label', '文章目录');

          const title = document.createElement('b');
          title.textContent = '文章目录';
          toc.append(title);
          const nav = document.createElement('nav');
          nav.setAttribute('aria-label', '本页章节');
          toc.append(nav);

          const used = new Set();
          const links = headings.map((heading, index) => {
            if (!heading.id) heading.id = makeId(heading.textContent || '', index, used);
            const link = document.createElement('a');
            link.href = `#${heading.id}`;
            link.textContent = heading.textContent || `第 ${index + 1} 节`;
            if (heading.tagName === 'H3') link.className = 'toc-subitem';
            nav.append(link);
            return link;
          });

          let ticking = false;
          const updateActive = () => {
            const current = [...headings].reverse().find((heading) => heading.getBoundingClientRect().top <= 120) || headings[0];
            links.forEach((link) => link.classList.toggle('is-active', link.getAttribute('href') === `#${current.id}`));
            ticking = false;
          };
          window.addEventListener('scroll', () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(updateActive);
          }, { passive: true });
          updateActive();
        });
      })();
    </script>
  </body>
</html>
